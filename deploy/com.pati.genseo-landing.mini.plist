<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GenSeo daily listicle landing DRAFT (1/day, never published). mini = primary.
     Slots: 08:15, 09:20 check, 16:15 catch-up. Same job: a running instance is
     not started again, and state/landing-daily.lock exits 0 if one is.
     /usr/bin/caffeinate -i -s is a user-level assertion. No sudo, no pmset.
     The script also arms caffeinate; a pull picks that up. These intervals
     arrive when scripts/genseo_self_apply.sh bootstraps this file after the
     running job exits. It does not start the job. An agent that was never
     loaded still needs the copy and bootstrap below. There is no Mini article
     plist here; self-apply does not install the MacBook article agent.
     install: cp deploy/com.pati.genseo-landing.mini.plist ~/Library/LaunchAgents/com.pati.genseo-landing.plist
              launchctl bootout gui/$(id -u) ~/Library/LaunchAgents/com.pati.genseo-landing.plist
              launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.pati.genseo-landing.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pati.genseo-landing</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>/bin/bash</string>
        <string>/Users/kevinkreative/genseo/scripts/run_landing_daily.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>GENSEO_HOST_ROLE</key><string>primary</string>
        <key>GENSEO_LANDING_STANDBY_DELAY_MIN</key><string>75</string>
        <key>GENSEO_LANDING_ARTICLE_YIELD_MIN</key><string>30</string>
        <key>GENSEO_NO_FACE</key><string>1</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>20</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>15</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/kevinkreative/genseo/logs/launchd-landing.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kevinkreative/genseo/logs/launchd-landing.err.log</string>
</dict>
</plist>
