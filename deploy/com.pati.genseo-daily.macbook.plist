<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MacBook article lane. Role is primary until the Mini daily job is explicitly
     enabled: a failover-release marker on main, these agents unloaded, then the
     Mini plist loaded as primary. Do not load this beside a Mini that is also
     primary. This plist does not read those markers.
     GENSEO_TICKET_PREFIX=MB so refill ids stay #MBmmdd-N and cannot collide
     with Mini MM. A primary host with no prefix would refill as MM.
     GENSEO_STANDBY_DELAY_MIN applies only if GENSEO_HOST_ROLE is later set
     to standby. GENSEO_NO_FACE=1 stays.
     launchd reads ~/Library/LaunchAgents/com.pati.genseo-daily.plist, not this
     copy. After pull: bash scripts/install_mac_daily_wrapper.sh (updates ~/bin
     only), then copy this plist over the LaunchAgent and bootstrap it again.
     Pulling alone does not update the wrapper launchd runs, and it does not
     reload these intervals.
     Slots: 07:30 batch, 08:05 check, 14:47 catch-up. The 08:05 slot is the
     same job. launchd will not start a second instance while one is running,
     and state/daily.lock exits 0 if one does. A day that already reached the
     target does not start a ticket. Intervals slept through coalesce into one
     fire on wake, so a missed 07:30 is retried at 08:05 instead of 14:47.
     ProgramArguments starts with /usr/bin/caffeinate -i -s. That is a
     user-level assertion (idle sleep, and system sleep on AC). No sudo and
     no pmset change. The wrapper also arms caffeinate itself. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pati.genseo-daily</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>-s</string>
        <string>/bin/bash</string>
        <string>/Users/kevinkreative/bin/grokbot-genseo-daily.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>GENSEO_DAILY_TARGET</key><string>5</string>
        <key>GENSEO_HOST_ROLE</key><string>primary</string>
        <key>GENSEO_TICKET_PREFIX</key><string>MB</string>
        <key>GENSEO_STANDBY_DELAY_MIN</key><string>20</string>
        <key>GENSEO_PEER_WINDOW_MIN</key><string>50</string>
        <key>GENSEO_NO_FACE</key><string>1</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>5</integer></dict>
        <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>47</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/kevinkreative/genseo/logs/launchd-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kevinkreative/genseo/logs/launchd-daily.err.log</string>
</dict>
</plist>
