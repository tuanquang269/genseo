{%- comment -%} GenSeo landing page (listicle/advertorial). Generated by scripts/landing_render.py.
  Renders page.content (inline-CSS body_html). The ONLY stylesheet: reset + one grid media query,
  namespaced gsl- / [data-gsl-*] so it cannot collide with the dawn-derived theme. Bump the suffix
  (-v2, -v3) on every change: Shopify caches compiled templates. {%- endcomment -%}
<style id="gsl-base">.gsl-landing *{box-sizing:border-box}.gsl-landing img{max-width:100%}.gsl-landing a:focus-visible{outline:3px solid #1e3a29;outline-offset:2px}[data-gsl-row]{grid-template-columns:1fr}[data-gsl-split]{grid-template-columns:1fr}@media (min-width:760px){[data-gsl-row]{grid-template-columns:2fr 1fr}[data-gsl-split]{grid-template-columns:1fr 1fr}}@media (prefers-reduced-motion:reduce){.gsl-landing *{scroll-behavior:auto!important}}</style>
<style id="gsl-hide-theme-chrome">
/* ============================================================
   HIDE THEME CHROME (announcement bar, header, footer, cart)
   This page is a full-takeover advertorial — no theme nav.
   GemPages prevents layout-none from working, so we
   hide everything that comes from theme.liquid via CSS instead.
   ============================================================ */
.announcement-bar,
.announcement-bar-section,
[id*="announcement-bar"],
[class*="announcement-bar"],
.shopify-section-header,
[id*="shopify-section-header"],
[id="shopify-section-header"],
section[id*="header"],
header.header,
header.section-header,
sticky-header,
#shopify-section-sections--__main__sections-header,
[id*="sections--"][id*="-header"],
.header-wrapper,
.site-header,
.shopify-section-footer,
[id*="shopify-section-footer"],
[id="shopify-section-footer"],
section[id*="footer"],
footer.footer,
footer.section-footer,
footer.gradient,
.footer,
.site-footer,
cart-drawer,
.cart-drawer,
.drawer,
.drawer__inner,
predictive-search,
.search-modal,
.cart-notification,
[id*="cart-drawer"],
[id*="cart-notification"],
[id*="CartDrawer"],
[id*="MenuDrawer"],
.utility-bar,
.utility-bar-section,
[class*="utility-bar"],
[id*="utility-bar"],
/* WellnessNest theme: horizontal-ticker = the green "Free Shipping / Money-Back / Trusted by" banner */
.horizontal-ticker,
.horizontal-ticker__container,
.horizontal-ticker__item,
[class*="horizontal-ticker"],
[id*="horizontal-ticker"],
/* Belt-and-suspenders: kill any custom-liquid section that wraps a horizontal ticker */
.shopify-section:has(.horizontal-ticker),
.shopify-section:has([class*="horizontal-ticker"])
{
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
  overflow: hidden !important;
}

/* Strip theme padding/margins from layout containers */
body, html { margin: 0 !important; padding: 0 !important; }
main, main#MainContent, .content-for-layout, [role="main"] {
  margin: 0 !important;
  padding: 0 !important;
  max-width: none !important;
  width: 100% !important;
}
.page-width, .container, .grid--container {
  max-width: none !important;
  margin: 0 !important;
  padding: 0 !important;
}
</style>

{{ page.content }}
